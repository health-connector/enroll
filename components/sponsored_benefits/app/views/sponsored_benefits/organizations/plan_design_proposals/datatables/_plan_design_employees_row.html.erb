<%# One Employee Roster row. Hired On renders the raw date while DOB is
    formatted. sorting_1 marks the default-ordered employee_name column. %>
<%
  dropdown = [
    ['Edit', sponsored_benefits.edit_plan_design_proposal_plan_design_census_employee_path(row.plan_design_proposal, row), 'ajax'],
    ['Delete', sponsored_benefits.plan_design_proposal_plan_design_census_employee_path(row.plan_design_proposal, row), 'delete ajax with confirm and elementId', 'Do you want to delete this employee?', 'plan_design_employee_delete']
  ]
%>
<tr class="<%= row_class %>">
  <%= render partial: 'datatables/bulk_actions_cell', locals: { id: row.to_param } %>
  <td class="col-string col-employee_name sorting_1"><%= row.full_name %></td>
  <td class="col-string col-dob"><%= row.dob.strftime("%m/%d/%Y") %></td>
  <td class="col-string col-hired_on"><%= row.hired_on %></td>
  <td class="col-string col-status"><%= row.aasm_state.titleize %></td>
  <% if table.show_est_participation? %>
    <td class="col-string col-est_participation"><%= row.expected_selection.titleize if row.expected_selection %></td>
  <% end %>
  <td class="col-string col-actions"><%= render partial: 'datatables/shared/dropdown', locals: { dropdowns: dropdown, row_actions_id: "plan_design_employee_#{row.id}" } %></td>
</tr>
